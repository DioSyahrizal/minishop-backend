# App
NODE_ENV=development
PORT=3000

# Postgres
POSTGRES_DB=minishop
POSTGRES_USER=minishop
POSTGRES_PASSWORD=minishop_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://minishop:minishop_dev@localhost:5432/minishop

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_USER=minishop
RABBITMQ_PASSWORD=minishop_dev
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
RABBITMQ_URL=amqp://minishop:minishop_dev@localhost:5672

# Generate your own: openssl rand -base64 48 (min 32 chars)
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=900
# Dev seed (npm run db:seed). Never used by the app itself.
SEED_ADMIN_EMAIL=admin@minishop.test
SEED_ADMIN_PASSWORD=
